\begin{code}

{-# OPTIONS --safe --without-K #-}

open import MLTT.Spartan
open import UF.FunExt
open import UF.PropTrunc

module gist.Orbifolds.SmoothLine where

open import Fin.Type
open import Naturals.Addition using () renaming (_+_ to _+ᴺ_)
open import UF.Base
open import UF.Equiv
open import UF.DiscreteAndSeparated using (𝟚-is-¬¬-separated)
open import UF.Sets
open import UF.Subsingletons
open import UF.Subsingletons-FunExt

\end{code}

Commutative rings.

\begin{code}

record Commutative-Ring : 𝓤₁ ̇ where
 field
  R : 𝓤₀ ̇
  R-is-set : is-set R
  0ᴿ 1ᴿ : R
  _+ᴿ_ _·ᴿ_ : R → R → R
  -ᴿ_ : R → R
  +-assoc : (x y z : R) → (x +ᴿ y) +ᴿ z ＝ x +ᴿ (y +ᴿ z)
  +-comm : (x y : R) → x +ᴿ y ＝ y +ᴿ x
  +-unit : (x : R) → x +ᴿ 0ᴿ ＝ x
  +-inverse : (x : R) → x +ᴿ (-ᴿ x) ＝ 0ᴿ
  ·-assoc : (x y z : R) → (x ·ᴿ y) ·ᴿ z ＝ x ·ᴿ (y ·ᴿ z)
  ·-comm : (x y : R) → x ·ᴿ y ＝ y ·ᴿ x
  ·-unit : (x : R) → x ·ᴿ 1ᴿ ＝ x
  distributivity : (x y z : R) → x ·ᴿ (y +ᴿ z) ＝ (x ·ᴿ y) +ᴿ (x ·ᴿ z)

 infixl 6 _+ᴿ_
 infixl 7 _·ᴿ_

\end{code}

Everything else is relative to a commutative ring 𝓡, the smooth line,
and uses function extensionality and propositional truncations.

\begin{code}

module smooth-line
        (fe : Fun-Ext)
        (pt : propositional-truncations-exist)
        (𝓡 : Commutative-Ring)
       where

 open PropositionalTruncation pt
 open Commutative-Ring 𝓡 public

 ·-zero : (x : R) → x ·ᴿ 0ᴿ ＝ 0ᴿ
 ·-zero x =
  x ·ᴿ 0ᴿ                                  ＝⟨ (+-unit (x ·ᴿ 0ᴿ))⁻¹ ⟩
  x ·ᴿ 0ᴿ +ᴿ 0ᴿ
   ＝⟨ ap (x ·ᴿ 0ᴿ +ᴿ_) ((+-inverse (x ·ᴿ 0ᴿ))⁻¹) ⟩
  x ·ᴿ 0ᴿ +ᴿ (x ·ᴿ 0ᴿ +ᴿ (-ᴿ (x ·ᴿ 0ᴿ)))
   ＝⟨ (+-assoc (x ·ᴿ 0ᴿ) (x ·ᴿ 0ᴿ) (-ᴿ (x ·ᴿ 0ᴿ)))⁻¹ ⟩
  x ·ᴿ 0ᴿ +ᴿ x ·ᴿ 0ᴿ +ᴿ (-ᴿ (x ·ᴿ 0ᴿ))
   ＝⟨ ap (_+ᴿ (-ᴿ (x ·ᴿ 0ᴿ))) ((distributivity x 0ᴿ 0ᴿ)⁻¹) ⟩
  x ·ᴿ (0ᴿ +ᴿ 0ᴿ) +ᴿ (-ᴿ (x ·ᴿ 0ᴿ))
   ＝⟨ ap (λ - → x ·ᴿ - +ᴿ (-ᴿ (x ·ᴿ 0ᴿ))) (+-unit 0ᴿ) ⟩
  x ·ᴿ 0ᴿ +ᴿ (-ᴿ (x ·ᴿ 0ᴿ))                ＝⟨ +-inverse (x ·ᴿ 0ᴿ) ⟩
  0ᴿ                                       ∎

 ·-interchange : (a b c d : R) → (a ·ᴿ b) ·ᴿ (c ·ᴿ d) ＝ (a ·ᴿ c) ·ᴿ (b ·ᴿ d)
 ·-interchange a b c d =
  (a ·ᴿ b) ·ᴿ (c ·ᴿ d)   ＝⟨ ·-assoc a b (c ·ᴿ d) ⟩
  a ·ᴿ (b ·ᴿ (c ·ᴿ d))   ＝⟨ ap (a ·ᴿ_) ((·-assoc b c d)⁻¹) ⟩
  a ·ᴿ ((b ·ᴿ c) ·ᴿ d)   ＝⟨ ap (λ - → a ·ᴿ (- ·ᴿ d)) (·-comm b c) ⟩
  a ·ᴿ ((c ·ᴿ b) ·ᴿ d)   ＝⟨ ap (a ·ᴿ_) (·-assoc c b d) ⟩
  a ·ᴿ (c ·ᴿ (b ·ᴿ d))   ＝⟨ (·-assoc a c (b ·ᴿ d))⁻¹ ⟩
  (a ·ᴿ c) ·ᴿ (b ·ᴿ d)   ∎

\end{code}

Powers, finite sums, invertible and nilpotent elements.

\begin{code}

 _^ᴿ_ : R → ℕ → R
 x ^ᴿ 0      = 1ᴿ
 x ^ᴿ succ k = (x ^ᴿ k) ·ᴿ x

 ∑ : {m : ℕ} → (Fin m → R) → R
 ∑ {0}      g = 0ᴿ
 ∑ {succ m} g = ∑ (g ∘ suc) +ᴿ g 𝟎

 ∑-of-zeros : {m : ℕ} (g : Fin m → R) → ((j : Fin m) → g j ＝ 0ᴿ) → ∑ g ＝ 0ᴿ
 ∑-of-zeros {0}      g z = refl
 ∑-of-zeros {succ m} g z = ap₂ _+ᴿ_ (∑-of-zeros (g ∘ suc) (z ∘ suc)) (z 𝟎)
                         ∙ +-unit 0ᴿ

 powers-of-one : (k : ℕ) → 1ᴿ ^ᴿ k ＝ 1ᴿ
 powers-of-one 0        = refl
 powers-of-one (succ k) = ·-unit (1ᴿ ^ᴿ k) ∙ powers-of-one k

 powers-of-products : (x y : R) (k : ℕ) → (x ·ᴿ y) ^ᴿ k ＝ (x ^ᴿ k) ·ᴿ (y ^ᴿ k)
 powers-of-products x y 0        = (·-unit 1ᴿ)⁻¹
 powers-of-products x y (succ k) =
  ap (_·ᴿ (x ·ᴿ y)) (powers-of-products x y k)
  ∙ ·-interchange (x ^ᴿ k) (y ^ᴿ k) x y

 is-invertible : R → 𝓤₀ ̇
 is-invertible x = Σ u ꞉ R , u ·ᴿ x ＝ 1ᴿ

 is-nilpotent : R → 𝓤₀ ̇
 is-nilpotent x = Σ k ꞉ ℕ , x ^ᴿ k ＝ 0ᴿ

 invertible-nilpotents-trivialize : (x : R)
                                  → is-invertible x
                                  → is-nilpotent x
                                  → 1ᴿ ＝ 0ᴿ
 invertible-nilpotents-trivialize x (u , p) (k , q) =
  (powers-of-one k)⁻¹
  ∙ ap (_^ᴿ k) (p ⁻¹)
  ∙ powers-of-products u x k
  ∙ ap (u ^ᴿ k ·ᴿ_) q
  ∙ ·-zero (u ^ᴿ k)

\end{code}

Postulate K [2, p. 30].

\begin{code}

 Postulate-K : 𝓤₀ ̇
 Postulate-K = (0ᴿ ≠ 1ᴿ)
             × ((n : ℕ) (x : Fin n → R)
                  → ¬ ((i : Fin n) → x i ＝ 0ᴿ)
                  → ∃ i ꞉ Fin n , is-invertible (x i))

\end{code}

Polynomial expressions and their values.

\begin{code}

 data Poly (n : ℕ) : 𝓤₀ ̇ where
  var : Fin n → Poly n
  con : R → Poly n
  _⊕_ _⊗_ : Poly n → Poly n → Poly n

 ⟦_⟧ : {n : ℕ} → Poly n → (Fin n → R) → R
 ⟦ var i ⟧ a = a i
 ⟦ con r ⟧ a = r
 ⟦ p ⊕ q ⟧ a = ⟦ p ⟧ a +ᴿ ⟦ q ⟧ a
 ⟦ p ⊗ q ⟧ a = ⟦ p ⟧ a ·ᴿ ⟦ q ⟧ a

\end{code}

Weil algebras by presentation, and their spectra.

\begin{code}

 record Weil-Presentation : 𝓤₀ ̇ where
  field
   vars eqns : ℕ
   poly : Fin eqns → Poly vars
   poly-at-zero : (j : Fin eqns) → ⟦ poly j ⟧ (λ _ → 0ᴿ) ＝ 0ᴿ
   exponent : ℕ
   coefficient : Fin vars → Fin eqns → Poly vars
   nilpotency : (i : Fin vars) (a : Fin vars → R)
              → a i ^ᴿ exponent
              ＝ ∑ (λ j → ⟦ coefficient i j ⟧ a ·ᴿ ⟦ poly j ⟧ a)

 Spec : Weil-Presentation → 𝓤₀ ̇
 Spec W = Σ a ꞉ (Fin vars → R) , ((j : Fin eqns) → ⟦ poly j ⟧ a ＝ 0ᴿ)
  where
   open Weil-Presentation W

 Spec-point : (W : Weil-Presentation) → Spec W
 Spec-point W = (λ _ → 0ᴿ) , poly-at-zero
  where
   open Weil-Presentation W

 coordinates-of-points-are-nilpotent
  : (W : Weil-Presentation) (v : Spec W) (i : Fin (Weil-Presentation.vars W))
  → is-nilpotent (pr₁ v i)
 coordinates-of-points-are-nilpotent W (a , z) i =
  exponent ,
  (nilpotency i a
   ∙ ∑-of-zeros _ (λ j → ap (⟦ coefficient i j ⟧ a ·ᴿ_) (z j)
                        ∙ ·-zero (⟦ coefficient i j ⟧ a)))
  where
   open Weil-Presentation W

\end{code}

For finitely many propositions, double negation commutes with the
conjunction.

\begin{code}

 ¬¬-Π-Fin : {𝓦 : Universe} {n : ℕ} (A : Fin n → 𝓦 ̇ )
          → ((i : Fin n) → ¬¬ A i) → ¬¬ ((i : Fin n) → A i)
 ¬¬-Π-Fin {𝓦} {0}      A h ν = ν (λ ())
 ¬¬-Π-Fin {𝓦} {succ n} A h ν =
  ¬¬-Π-Fin (A ∘ suc) (h ∘ suc)
   (λ g → h 𝟎 (λ a → ν (λ { (suc i) → g i ; 𝟎 → a })))

\end{code}

Under Postulate K, nilpotent elements are infinitesimal, the points of
a spectrum are not distinct from the base point, and maps from a
spectrum to 𝟚 are constant.

\begin{code}

 module _ (K : Postulate-K) where

  nonzero-elements-are-invertible : (x : R) → x ≠ 0ᴿ → ∥ is-invertible x ∥
  nonzero-elements-are-invertible x ν =
   ∥∥-functor (λ (_ , u) → u) (pr₂ K 1 (λ _ → x) (λ z → ν (z 𝟎)))

  nilpotents-are-infinitesimal : (x : R) → is-nilpotent x → ¬¬ (x ＝ 0ᴿ)
  nilpotents-are-infinitesimal x n ν =
   ∥∥-rec 𝟘-is-prop
    (λ u → pr₁ K ((invertible-nilpotents-trivialize x u n)⁻¹))
    (nonzero-elements-are-invertible x ν)

  points-of-spectra-are-infinitesimal
   : (W : Weil-Presentation) (v : Spec W) → ¬¬ (v ＝ Spec-point W)
  points-of-spectra-are-infinitesimal W (a , z) =
   ¬¬-functor γ
    (¬¬-Π-Fin (λ i → a i ＝ 0ᴿ)
      (λ i → nilpotents-are-infinitesimal (a i)
              (coordinates-of-points-are-nilpotent W (a , z) i)))
   where
    open Weil-Presentation W

    γ : ((i : Fin vars) → a i ＝ 0ᴿ) → (a , z) ＝ Spec-point W
    γ h = to-subtype-＝ (λ b → Π-is-prop fe (λ j → R-is-set)) (dfunext fe h)

  maps-from-spectra-to-𝟚-are-constant
   : (W : Weil-Presentation) (f : Spec W → 𝟚) (v : Spec W)
   → f v ＝ f (Spec-point W)
  maps-from-spectra-to-𝟚-are-constant W f v =
   𝟚-is-¬¬-separated (f v) (f (Spec-point W))
    (¬¬-functor (ap f) (points-of-spectra-are-infinitesimal W v))

\end{code}

Normalization (added at orbifold gate H8, after the review of
13 November 2026 [3, 4]). The presentation is kept, and the powers
x_i^(k+1) of the coordinates are appended to its equations, where k is
the exponent of the witness. They vanish on the solutions of the old
equations, by the witness, so the spectrum does not change: the
spectra of normalize W and of W are equivalent as pointed types over
Rⁿ (normalization-equivalence). The appended powers occur literally
among the equations of normalize W (powers-are-equations), so, on
paper, the augmentation ideal of its quotient algebra is nilpotent;
what is proved here is powers-are-equations. Its own witness is the
corresponding equation with coefficient 1 and the others 0. No
postulate of the smooth line is used.

\begin{code}

 power : {n : ℕ} → Poly n → ℕ → Poly n
 power p 0        = con 1ᴿ
 power p (succ k) = power p k ⊗ p

 value-of-power : {n : ℕ} (p : Poly n) (k : ℕ) (a : Fin n → R)
                → ⟦ power p k ⟧ a ＝ ⟦ p ⟧ a ^ᴿ k
 value-of-power p 0        a = refl
 value-of-power p (succ k) a = ap (_·ᴿ ⟦ p ⟧ a) (value-of-power p k a)

 ·-zero-left : (x : R) → 0ᴿ ·ᴿ x ＝ 0ᴿ
 ·-zero-left x = ·-comm 0ᴿ x ∙ ·-zero x

 ·-unit-left : (x : R) → 1ᴿ ·ᴿ x ＝ x
 ·-unit-left x = ·-comm 1ᴿ x ∙ ·-unit x

 +-unit-left : (x : R) → 0ᴿ +ᴿ x ＝ x
 +-unit-left x = +-comm 0ᴿ x ∙ +-unit x

\end{code}

Families on Fin (m + n) from families on Fin m and Fin n.

\begin{code}

 join : {𝓦 : Universe} {A : 𝓦 ̇ } {m n : ℕ}
      → (Fin m → A) → (Fin n → A) → Fin (m +ᴺ n) → A
 join {𝓦} {A} {m} {0}      f g       = f
 join {𝓦} {A} {m} {succ n} f g (suc x) = join f (g ∘ suc) x
 join {𝓦} {A} {m} {succ n} f g 𝟎       = g 𝟎

 left-index : {m n : ℕ} → Fin m → Fin (m +ᴺ n)
 left-index {m} {0}      x = x
 left-index {m} {succ n} x = suc (left-index {m} {n} x)

 right-index : {m n : ℕ} → Fin n → Fin (m +ᴺ n)
 right-index {m} {0}      ()
 right-index {m} {succ n} (suc y) = suc (right-index {m} {n} y)
 right-index {m} {succ n} 𝟎       = 𝟎

 join-left : {𝓦 : Universe} {A : 𝓦 ̇ } {m n : ℕ} (f : Fin m → A) (g : Fin n → A)
             (x : Fin m) → join f g (left-index x) ＝ f x
 join-left {𝓦} {A} {m} {0}      f g x = refl
 join-left {𝓦} {A} {m} {succ n} f g x = join-left f (g ∘ suc) x

 join-right
  : {𝓦 : Universe} {A : 𝓦 ̇ } {m n : ℕ} (f : Fin m → A) (g : Fin n → A)
              (y : Fin n) → join f g (right-index y) ＝ g y
 join-right {𝓦} {A} {m} {0}      f g ()
 join-right {𝓦} {A} {m} {succ n} f g (suc y) = join-right f (g ∘ suc) y
 join-right {𝓦} {A} {m} {succ n} f g 𝟎       = refl

 join-induction : {𝓦 𝓣 : Universe} {A : 𝓦 ̇ } {m n : ℕ}
                  (Q : A → 𝓣 ̇ ) (f : Fin m → A) (g : Fin n → A)
                → ((x : Fin m) → Q (f x))
                → ((y : Fin n) → Q (g y))
                → (z : Fin (m +ᴺ n)) → Q (join f g z)
 join-induction {𝓦} {𝓣} {A} {m} {0}      Q f g u v z       = u z
 join-induction {𝓦} {𝓣} {A} {m} {succ n} Q f g u v (suc z) =
  join-induction Q f (g ∘ suc) u (v ∘ suc) z
 join-induction {𝓦} {𝓣} {A} {m} {succ n} Q f g u v 𝟎       = v 𝟎

 join-pointwise : {𝓦 𝓦' : Universe} {A : 𝓦 ̇ } {B : 𝓦' ̇ } {m n : ℕ}
                  (h : A → A → B) (f f' : Fin m → A) (g g' : Fin n → A)
                → (λ z → h (join f g z) (join f' g' z))
                ∼ join (λ x → h (f x) (f' x)) (λ y → h (g y) (g' y))
 join-pointwise {𝓦} {𝓦'} {A} {B} {m} {0}      h f f' g g' z       = refl
 join-pointwise {𝓦} {𝓦'} {A} {B} {m} {succ n} h f f' g g' (suc z) =
  join-pointwise h f f' (g ∘ suc) (g' ∘ suc) z
 join-pointwise {𝓦} {𝓦'} {A} {B} {m} {succ n} h f f' g g' 𝟎       = refl

 ∑-of-join : {m n : ℕ} (f : Fin m → R) (g : Fin n → R)
           → ∑ (join f g) ＝ ∑ f +ᴿ ∑ g
 ∑-of-join {m} {0}      f g = (+-unit (∑ f))⁻¹
 ∑-of-join {m} {succ n} f g =
  ap (_+ᴿ g 𝟎) (∑-of-join f (g ∘ suc))
  ∙ +-assoc (∑ f) (∑ (g ∘ suc)) (g 𝟎)

\end{code}

Kronecker coefficients.

\begin{code}

 δ : {n : ℕ} → Fin n → Fin n → R
 δ {0}      ()      _
 δ {succ n} (suc i) (suc j) = δ i j
 δ {succ n} (suc i) 𝟎       = 0ᴿ
 δ {succ n} 𝟎       (suc j) = 0ᴿ
 δ {succ n} 𝟎       𝟎       = 1ᴿ

 Kronecker-sum : {n : ℕ} (i : Fin n) (g : Fin n → R)
               → ∑ (λ j → δ i j ·ᴿ g j) ＝ g i
 Kronecker-sum {0}      ()      g
 Kronecker-sum {succ n} (suc i) g =
  ap₂ _+ᴿ_ (Kronecker-sum i (g ∘ suc)) (·-zero-left (g 𝟎))
  ∙ +-unit (g (suc i))
 Kronecker-sum {succ n} 𝟎 g =
  ap₂ _+ᴿ_ (∑-of-zeros (λ j → 0ᴿ ·ᴿ g (suc j)) (λ j → ·-zero-left (g (suc j))))
           (·-unit-left (g 𝟎))
  ∙ +-unit-left (g 𝟎)

\end{code}

The normalized presentation and the pointed equivalence of spectra.

\begin{code}

 coordinate-powers : (W : Weil-Presentation)
                   → Fin (Weil-Presentation.vars W)
                   → Poly (Weil-Presentation.vars W)
 coordinate-powers W i = power (var i) (succ (Weil-Presentation.exponent W))

 normalize : Weil-Presentation → Weil-Presentation
 normalize W = record
  { vars = vars
   ; eqns = eqns +ᴺ vars
   ; poly = join poly powers
   ; poly-at-zero = join-induction (λ p → ⟦ p ⟧ (λ _ → 0ᴿ) ＝ 0ᴿ) poly powers
                    poly-at-zero
                     (λ i → ·-zero (⟦ power (var i) exponent ⟧ (λ _ → 0ᴿ)))
   ; exponent = succ exponent
   ; coefficient = λ i → join (λ _ → con 0ᴿ) (λ i' → con (δ i i'))
   ; nilpotency = witness
   }
  where
   open Weil-Presentation W

   powers : Fin vars → Poly vars
   powers = coordinate-powers W

   witness : (i : Fin vars) (a : Fin vars → R)
           → a i ^ᴿ succ exponent
           ＝ ∑ (λ z → ⟦ join (λ _ → con 0ᴿ) (λ i' → con (δ i i')) z ⟧ a
                      ·ᴿ ⟦ join poly powers z ⟧ a)
   witness i a =
    a i ^ᴿ succ exponent
     ＝⟨ (value-of-power (var i) (succ exponent) a)⁻¹ ⟩
    ⟦ powers i ⟧ a
     ＝⟨ (Kronecker-sum i (λ i' → ⟦ powers i' ⟧ a))⁻¹ ⟩
    ∑ (λ i' → δ i i' ·ᴿ ⟦ powers i' ⟧ a)              ＝⟨ (+-unit-left _)⁻¹ ⟩
    0ᴿ +ᴿ ∑ (λ i' → δ i i' ·ᴿ ⟦ powers i' ⟧ a)
     ＝⟨ ap (_+ᴿ ∑ (λ i' → δ i i' ·ᴿ ⟦ powers i' ⟧ a)) (zeros ⁻¹) ⟩
    ∑ (λ j → 0ᴿ ·ᴿ ⟦ poly j ⟧ a)
     +ᴿ ∑ (λ i' → δ i i' ·ᴿ ⟦ powers i' ⟧ a)
      ＝⟨ (∑-of-join (λ j → 0ᴿ ·ᴿ ⟦ poly j ⟧ a)
               (λ i' → δ i i' ·ᴿ ⟦ powers i' ⟧ a))⁻¹ ⟩
    ∑ (join (λ j → 0ᴿ ·ᴿ ⟦ poly j ⟧ a)
            (λ i' → δ i i' ·ᴿ ⟦ powers i' ⟧ a))
             ＝⟨ ap ∑ (dfunext fe (join-pointwise h (λ _ → con 0ᴿ) poly
                      (λ i' → con (δ i i')) powers))⁻¹ ⟩
    ∑ (λ z → ⟦ join (λ _ → con 0ᴿ) (λ i' → con (δ i i')) z ⟧ a
             ·ᴿ ⟦ join poly powers z ⟧ a)              ∎
     where
      h : Poly vars → Poly vars → R
      h p q = ⟦ p ⟧ a ·ᴿ ⟦ q ⟧ a

      zeros : ∑ (λ j → 0ᴿ ·ᴿ ⟦ poly j ⟧ a) ＝ 0ᴿ
      zeros = ∑-of-zeros _ (λ j → ·-zero-left (⟦ poly j ⟧ a))

 powers-are-equations
  : (W : Weil-Presentation) (i : Fin (Weil-Presentation.vars W))
  → Weil-Presentation.poly (normalize W) (right-index i)
  ＝ power (var i) (succ (Weil-Presentation.exponent W))
 powers-are-equations W i =
  join-right (Weil-Presentation.poly W) (coordinate-powers W) i

 equations-are-props
  : (W : Weil-Presentation) (a : Fin (Weil-Presentation.vars W) → R)
  → is-prop ((j : Fin (Weil-Presentation.eqns W))
              → ⟦ Weil-Presentation.poly W j ⟧ a ＝ 0ᴿ)
 equations-are-props W a = Π-is-prop fe (λ j → R-is-set)

 normalization-equivalence : (W : Weil-Presentation)
                           → Spec (normalize W) ≃ Spec W
 normalization-equivalence W =
  qinveq forget
   (add , (λ v → to-subtype-＝ (equations-are-props (normalize W)) refl) ,
          (λ v → to-subtype-＝ (equations-are-props W) refl))
  where
   open Weil-Presentation W

   forget : Spec (normalize W) → Spec W
   forget (a , z) = a , (λ j → transport (λ p → ⟦ p ⟧ a ＝ 0ᴿ)
                                (join-left poly (coordinate-powers W) j)
                                (z (left-index j)))

   add : Spec W → Spec (normalize W)
   add (a , z) =
    a , join-induction (λ p → ⟦ p ⟧ a ＝ 0ᴿ) poly (coordinate-powers W)
                      z vanishes
    where
     vanishes : (i : Fin vars) → ⟦ power (var i) (succ exponent) ⟧ a ＝ 0ᴿ
     vanishes i = ap (_·ᴿ a i) (value-of-power (var i) exponent a
                                ∙ pr₂ (coordinates-of-points-are-nilpotent W
                                        (a , z) i))
                ∙ ·-zero-left (a i)

 normalization-equivalence-is-pointed
  : (W : Weil-Presentation)
  → ⌜ normalization-equivalence W ⌝ (Spec-point (normalize W)) ＝ Spec-point W
 normalization-equivalence-is-pointed W =
  to-subtype-＝ (equations-are-props W) refl

 normalization-equivalence-is-over-Rⁿ
  : (W : Weil-Presentation)
  → pr₁ ∘ ⌜ normalization-equivalence W ⌝ ∼ pr₁
 normalization-equivalence-is-over-Rⁿ W v = refl

\end{code}

