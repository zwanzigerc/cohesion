{-# OPTIONS --cohesion --without-K --flat-split #-}

module CapturedReindexingExamples where

open import Foundations
import CapturedShape as C
open C using (CapturedShape)
open import CaptureShape using (shape)
open import CaptureContext
import RelativeSliceShape as R
open import PullbackSetFibers using (transport; pullback-set-fibers)
open import DiscretePullback using (Pullback; pullback-discrete)

module Base (@♭ A : Set) where
  shaped : CapturedShape A
  shaped = shape

module Fresh (@♭ A : Set) where
  shaped : CapturedShape (A × A)
  shaped = shape

TypeContext : Set₁
TypeContext = CrispΣ Set (λ _ → CrispUnitAt (lsuc lzero))

-- The native substitution A ↦ A × A acts on the captured context.
square-context : TypeContext → TypeContext
square-context (pair A tail) = pair (A × A) tail

module Example (@♭ A : Set) where
  -- The same whole-slice factorization as ShapeReindexing.Comparison,
  -- applied to the actual families generated by automatic capture.
  original = C.Output.whole-context (Base.shaped (A × A))
  fresh = C.Output.whole-context (Fresh.shaped A)

  PulledFamily : TypeContext → Set₁
  PulledFamily γ = R.Output.family original (square-context γ)

  PulledTotal : Set₁
  PulledTotal = Pullback (R.Output.projection original) square-context

  pulled-projection : PulledTotal → TypeContext
  pulled-projection = fst

  pulled-discrete : Discrete PulledTotal
  pulled-discrete = pullback-discrete telescope-discrete telescope-discrete
    (R.Output.total-discrete original)
    (R.Output.projection original) square-context

  pulled-set-fibers : R.SetFibers pulled-projection
  pulled-set-fibers = pullback-set-fibers
    (R.Output.projection original) square-context (R.Output.family-set original)

  -- Capture compiles its source family as an eliminator. Its fresh family
  -- and the composite old-family ∘ square-context have different normal
  -- forms. This explicit pulled-back unit avoids requiring function
  -- extensionality or an additional shape axiom.
  pulled-unit-function : Σ TypeContext (C.Output.family (Fresh.shaped A))
                       → PulledTotal
  pulled-unit-function (pair B end-at , raise value) =
    pair B end-at , R.Output.family-unit original
      (pair (B × B) end-at) (raise value)

  pulled-unit : R.MapOver (fst {B = C.Output.family (Fresh.shaped A)})
                         pulled-projection
  pulled-unit = R.over-map pulled-unit-function
    (λ { (pair B end-at , raise value) → refl })

  comparison-over : R.MapOver (R.Output.projection fresh) pulled-projection
  comparison-over = R.Output.factor fresh PulledTotal pulled-discrete
    pulled-projection pulled-set-fibers pulled-unit

  comparison-at : (γ : TypeContext)
                → R.Output.family fresh γ → PulledFamily γ
  comparison-at γ (z , e) = transport PulledFamily
    (R.triangle comparison-over z ∙ e)
    (snd (R.function comparison-over z))

  comparison : C.Output.carrier (Fresh.shaped A)
             → C.Output.carrier (Base.shaped (A × A))
  comparison = comparison-at (C.Output.point (Fresh.shaped A))

  comparison-on-unit : (a b : A)
    → comparison (C.Output.unit (Fresh.shaped A) (a , b))
      ≡ C.Output.unit (Base.shaped (A × A)) (a , b)
  comparison-on-unit a b = ap
    (λ h → transport PulledFamily
      (R.triangle h (pair A end-at , raise (a , b)))
      (snd (R.function h (pair A end-at , raise (a , b)))))
    (R.Output.factor-β fresh PulledTotal pulled-discrete
      pulled-projection pulled-set-fibers pulled-unit)
