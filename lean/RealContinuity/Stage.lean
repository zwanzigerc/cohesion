import RealContinuity.Designated

/-!
# Stages: the objects of the controlled site

Every stage is a subset of a finite product of the six primitive spaces
`*, ℝ, L, S, K, P`, with the subspace topology. Stages are generated by

* the primitive spaces;
* finite products;
* nonempty connected open subspaces;
* actual topological pullbacks `U ×_B D` of a FIXED designated map `g : D → B`
  along an arbitrary continuous map `U → B` from a stage.

The designated family `G` consists of every `q_T`, every `r_T`, and their controlled
bounded restrictions corestricted to their actual open images (`QBox`, `RBall`).
No closure under arbitrary finite pullbacks is imposed.

The generation is an inductive predicate `IsStage` on pairs (shape, subset). This
makes the site small (`Stage : Type`) and gives the strong induction principle
used for the stage invariants. Codes may denote homeomorphic or equal spaces.
The category is full: morphisms are all continuous maps.
-/

noncomputable section

open Set Topology Filter unitInterval CategoryTheory

namespace RealContinuity

/-! ### Primitive spaces and shapes -/

/-- The primitive spaces `*, ℝ, L, S, K, P`. -/
inductive Prim
  | point | real | ray | sierp | kpair | paths

/-- The underlying type of a primitive space. -/
@[reducible] def Prim.space : Prim → Type
  | .point => PUnit
  | .real => ℝ
  | .ray => L
  | .sierp => Prop
  | .kpair => ↥Kset
  | .paths => C(I, L)

instance Prim.top : (p : Prim) → TopologicalSpace p.space
  | .point => inferInstanceAs (TopologicalSpace PUnit)
  | .real => inferInstanceAs (TopologicalSpace ℝ)
  | .ray => inferInstanceAs (TopologicalSpace L)
  | .sierp => inferInstanceAs (TopologicalSpace Prop)
  | .kpair => inferInstanceAs (TopologicalSpace ↥Kset)
  | .paths => inferInstanceAs (TopologicalSpace C(I, L))

theorem Prim.good : (p : Prim) → Good p.space
  | .point => good_punit
  | .real => good_real
  | .ray => good_L
  | .sierp => good_sierpinski
  | .kpair => good_K
  | .paths => good_P

/-- Shapes of finite products of primitive spaces. -/
inductive Shape
  | prim (p : Prim)
  | pair (a b : Shape)

/-- The ambient product space of a shape. -/
@[reducible] def Shape.Carrier : Shape → Type
  | .prim p => p.space
  | .pair a b => a.Carrier × b.Carrier

instance Shape.top : (s : Shape) → TopologicalSpace s.Carrier
  | .prim p => Prim.top p
  | .pair a b => @instTopologicalSpaceProd _ _ (Shape.top a) (Shape.top b)

/-! ### The designated family `G` -/

/-- Indices of the designated maps. -/
inductive GIdx
  | q (o : Option L₀)
  | r (o : Option L₀)
  | qBox (B : QBox)
  | rBall (B : RBall)

namespace GIdx

/-- The primitive space containing the domain. -/
@[reducible] def amb : GIdx → Prim
  | .q _ => .ray
  | .r _ => .paths
  | .qBox _ => .ray
  | .rBall _ => .paths

/-- The domain, as a subset of its primitive space. -/
def dom : (g : GIdx) → Set g.amb.space
  | .q o => tailOf o
  | .r o => PT (tailOf o)
  | .qBox B => B.J
  | .rBall B => B.V

/-- The base: the actual image of the map. -/
@[reducible] def Base : GIdx → Type
  | .q _ => Prop
  | .r o => ↥(KT (tailOf o))
  | .qBox _ => ↥QBox.Img
  | .rBall B => ↥B.Img

instance baseTop : (g : GIdx) → TopologicalSpace g.Base
  | .q _ => inferInstanceAs (TopologicalSpace Prop)
  | .r o => inferInstanceAs (TopologicalSpace ↥(KT (tailOf o)))
  | .qBox _ => inferInstanceAs (TopologicalSpace ↥QBox.Img)
  | .rBall B => inferInstanceAs (TopologicalSpace ↥B.Img)

/-- The designated map. -/
def map : (g : GIdx) → C(g.dom, g.Base)
  | .q o => qT o
  | .r o => rT o
  | .qBox B => B.map
  | .rBall B => B.map

theorem goodMap : (g : GIdx) → GoodMap g.map
  | .q o => goodMap_qT o
  | .r o => goodMap_rT o
  | .qBox B => B.goodMap
  | .rBall B => B.goodMap

end GIdx

/-! ### Stages -/

/-- The actual topological pullback of `g` along `f`, inside the ambient product. -/
def pbSet {s : Shape} (A : Set s.Carrier) (g : GIdx) (f : C(A, g.Base)) :
    Set (Shape.pair s (.prim g.amb)).Carrier :=
  {x | ∃ (h₁ : x.1 ∈ A) (h₂ : x.2 ∈ g.dom), f ⟨x.1, h₁⟩ = g.map ⟨x.2, h₂⟩}

/-- The generation of stages. -/
inductive IsStage : (s : Shape) → Set s.Carrier → Prop
  | prim (p : Prim) : IsStage (.prim p) univ
  | prod {a b : Shape} {A : Set a.Carrier} {B : Set b.Carrier} :
      IsStage a A → IsStage b B → IsStage (.pair a b) (A ×ˢ B)
  | opn {a : Shape} {A U : Set a.Carrier} : IsStage a A → U ⊆ A →
      IsOpen ((↑) ⁻¹' U : Set A) → IsConnected U → IsStage a U
  | pb {a : Shape} {A : Set a.Carrier} (g : GIdx) (f : C(A, g.Base)) :
      IsStage a A → IsStage (.pair a (.prim g.amb)) (pbSet A g f)

/-- The pullback subset is the topological pullback of `f` and `g`. -/
def pbSetHomeo {s : Shape} (A : Set s.Carrier) (g : GIdx) (f : C(A, g.Base)) :
    ↥(pbSet A g f) ≃ₜ TopPullback f g.map where
  toFun x := ⟨(⟨x.1.1, x.2.fst⟩, ⟨x.1.2, x.2.snd.fst⟩), x.2.snd.snd⟩
  invFun y := ⟨(y.1.1.1, y.1.2.1), y.1.1.2, y.1.2.2, y.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  continuous_toFun := by
    apply Continuous.subtype_mk
    apply Continuous.prodMk
    · exact (continuous_fst.comp continuous_subtype_val).subtype_mk _
    · exact (continuous_snd.comp continuous_subtype_val).subtype_mk _
  continuous_invFun := by
    apply Continuous.subtype_mk
    exact (continuous_subtype_val.comp (continuous_fst.comp continuous_subtype_val)).prodMk
      (continuous_subtype_val.comp (continuous_snd.comp continuous_subtype_val))

/-- Goodness transfers along homeomorphisms. -/
theorem Good.of_homeomorph {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (e : X ≃ₜ Y) (h : Good X) : Good Y := by
  have := h.connected
  refine ⟨connectedSpace_of_homeomorph e, fun y N hN => ?_⟩
  have hN' : e ⁻¹' N ∈ 𝓝 (e.symm y) := by
    apply e.continuous.continuousAt.preimage_mem_nhds
    rw [e.apply_symm_apply]; exact hN
  obtain ⟨W, hWo, hyW, hWN, hWc, hWf⟩ := h.basis _ _ hN'
  have e' : ↥W ≃ₜ ↥(e '' W) := e.image W
  refine ⟨e '' W, e.isOpenMap W hWo, ⟨e.symm y, hyW, e.apply_symm_apply y⟩, ?_,
    connectedSpace_of_homeomorph e', hWf.of_homeomorph e'⟩
  rintro _ ⟨x, hx, rfl⟩
  exact hWN hx

/-- **Every stage is good**: nonempty, connected, with a basis of connected
open neighbourhoods of pairwise finite `Q`-height. -/
theorem IsStage.good {s : Shape} {A : Set s.Carrier} (h : IsStage s A) : Good A := by
  induction h with
  | prim p => exact (Prim.good p).of_homeomorph (Homeomorph.Set.univ p.space).symm
  | prod _ _ ihA ihB => exact (ihA.prod ihB).of_homeomorph (Homeomorph.Set.prod _ _).symm
  | @opn a A U _ hUA hUo hUc ih =>
    have := isConnected_iff_connectedSpace.mp hUc
    have : ConnectedSpace ((↑) ⁻¹' U : Set A) :=
      connectedSpace_of_homeomorph (preimageValHomeo hUA).symm
    exact (ih.subspace hUo).of_homeomorph (preimageValHomeo hUA)
  | pb g f _ ih => exact (ih.pullback g.goodMap f).of_homeomorph (pbSetHomeo _ g f).symm

/-- A stage: a generated subset of a finite product of primitive spaces. -/
structure Stage where
  shape : Shape
  set : Set shape.Carrier
  isStage : IsStage shape set

namespace Stage

/-- The underlying space of a stage. -/
abbrev X (U : Stage) : Type := ↥U.set

theorem good (U : Stage) : Good U.X := U.isStage.good

instance (U : Stage) : ConnectedSpace U.X := U.good.connected

instance (U : Stage) : Nonempty U.X := U.good.nonempty

instance (U : Stage) : LocallyConnectedSpace U.X := U.good.locallyConnected

theorem pairwise (U : Stage) : PairwiseFiniteHeight (TopCat.of U.X) := U.good.pairwise

/-- The full category of stages and continuous maps. -/
instance : SmallCategory Stage where
  Hom U V := C(U.X, V.X)
  id U := ContinuousMap.id U.X
  comp f g := g.comp f

instance (U V : Stage) : FunLike (U ⟶ V) U.X V.X :=
  inferInstanceAs (FunLike C(U.X, V.X) U.X V.X)

instance (U V : Stage) : ContinuousMapClass (U ⟶ V) U.X V.X :=
  inferInstanceAs (ContinuousMapClass C(U.X, V.X) U.X V.X)

/-- A continuous map as a morphism of stages. -/
def ofHom {U V : Stage} (f : C(U.X, V.X)) : U ⟶ V := f

/-- A morphism of stages as a continuous map. -/
def toCont {U V : Stage} (f : U ⟶ V) : C(U.X, V.X) := f

@[simp] theorem ofHom_apply {U V : Stage} (f : C(U.X, V.X)) (x : U.X) : ofHom f x = f x := rfl

@[simp] theorem toCont_apply {U V : Stage} (f : U ⟶ V) (x : U.X) : toCont f x = f x := rfl

@[simp] theorem comp_apply {U V W : Stage} (f : U ⟶ V) (g : V ⟶ W) (x : U.X) :
    (f ≫ g) x = g (f x) := rfl

@[simp] theorem id_apply (U : Stage) (x : U.X) : (𝟙 U : U ⟶ U) x = x := rfl

@[ext] theorem hom_ext {U V : Stage} {f g : U ⟶ V} (h : ∀ x, f x = g x) : f = g :=
  ContinuousMap.ext h

theorem hom_continuous {U V : Stage} (f : U ⟶ V) : Continuous f := map_continuous f

/-! #### Basic stages -/

/-- A primitive space as a stage. -/
def prim (p : Prim) : Stage := ⟨.prim p, univ, .prim p⟩

/-- The point stage. -/
def point : Stage := prim .point

instance : Unique point.X where
  default := ⟨PUnit.unit, mem_univ _⟩
  uniq x := Subtype.ext (by cases x.1; rfl)

/-- The real line as a stage. -/
def real : Stage := prim .real

/-- The real line is homeomorphic to its stage. -/
def realHomeo : real.X ≃ₜ ℝ := Homeomorph.Set.univ ℝ

/-- The binary product of stages. -/
def prod (U V : Stage) : Stage := ⟨.pair U.shape V.shape, U.set ×ˢ V.set, .prod U.isStage V.isStage⟩

/-- The product stage is the product space. -/
def prodHomeo (U V : Stage) : (prod U V).X ≃ₜ U.X × V.X := Homeomorph.Set.prod _ _

/-- A nonempty connected open subspace of a stage. -/
def opn (U : Stage) (O : Set U.X) (hO : IsOpen O) (hc : IsConnected O) : Stage where
  shape := U.shape
  set := Subtype.val '' O
  isStage := by
    refine .opn U.isStage (by rintro _ ⟨x, -, rfl⟩; exact x.2) ?_ (hc.image _
      continuous_subtype_val.continuousOn)
    rwa [Subtype.val_injective.preimage_image]

theorem opn_mem {U : Stage} {O : Set U.X} {hO : IsOpen O} {hc : IsConnected O}
    (x : (opn U O hO hc).X) : x.1 ∈ U.set := by
  obtain ⟨y, -, hy⟩ := x.2; rw [← hy]; exact y.2

theorem opn_memO {U : Stage} {O : Set U.X} {hO : IsOpen O} {hc : IsConnected O}
    (x : (opn U O hO hc).X) : (⟨x.1, opn_mem x⟩ : U.X) ∈ O := by
  obtain ⟨y, hy, hyx⟩ := x.2
  have : y = ⟨x.1, opn_mem x⟩ := Subtype.ext hyx
  rw [← this]; exact hy

/-- The open subspace is homeomorphic to its stage. -/
def opnHomeo (U : Stage) (O : Set U.X) (hO : IsOpen O) (hc : IsConnected O) :
    (opn U O hO hc).X ≃ₜ O where
  toFun x := ⟨⟨x.1, opn_mem x⟩, opn_memO x⟩
  invFun y := ⟨y.1.1, y.1, y.2, rfl⟩
  left_inv _ := rfl
  right_inv _ := rfl
  continuous_toFun := by
    apply Continuous.subtype_mk
    exact continuous_subtype_val.subtype_mk _
  continuous_invFun := by
    apply Continuous.subtype_mk
    have h1 : Continuous (Subtype.val : U.X → U.shape.Carrier) := continuous_subtype_val
    have h2 : Continuous (Subtype.val : O → U.X) := continuous_subtype_val
    exact h1.comp h2

/-- The inclusion of an open subspace stage. -/
def opnIncl (U : Stage) (O : Set U.X) (hO : IsOpen O) (hc : IsConnected O) :
    opn U O hO hc ⟶ U :=
  ⟨fun x => ⟨x.1, opn_mem x⟩, continuous_subtype_val.subtype_mk _⟩

@[simp] theorem opnIncl_val (U : Stage) (O : Set U.X) (hO : IsOpen O) (hc : IsConnected O)
    (x : (opn U O hO hc).X) : ((opnIncl U O hO hc x : U.X) : U.shape.Carrier) = x.1 := rfl

theorem range_opnIncl (U : Stage) (O : Set U.X) (hO : IsOpen O) (hc : IsConnected O) :
    range (opnIncl U O hO hc) = O := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨z, hz, hzx⟩ := x.2
    have : z = opnIncl U O hO hc x := Subtype.ext hzx
    rw [← this]; exact hz
  · intro hy
    exact ⟨⟨y.1, y, hy, rfl⟩, rfl⟩

theorem isOpenEmbedding_opnIncl (U : Stage) (O : Set U.X) (hO : IsOpen O) (hc : IsConnected O) :
    IsOpenEmbedding (opnIncl U O hO hc) := by
  have e : (opnIncl U O hO hc : (opn U O hO hc).X → U.X) =
      Subtype.val ∘ (opnHomeo U O hO hc) := rfl
  rw [e]
  exact hO.isOpenEmbedding_subtypeVal.comp (opnHomeo U O hO hc).isOpenEmbedding

/-- A connected open neighbourhood of a point inside any neighbourhood, as a stage. -/
theorem exists_opn {U : Stage} {x : U.X} {N : Set U.X} (hN : N ∈ 𝓝 x) :
    ∃ (O : Set U.X) (_ : IsOpen O) (_ : IsConnected O), x ∈ O ∧ O ⊆ N := by
  obtain ⟨O, hON, hO, hxO, hc⟩ :=
    (locallyConnectedSpace_iff_subsets_isOpen_isConnected.mp inferInstance) x N hN
  exact ⟨O, hO, hc, hxO, hON⟩

/-- The designated pullback stage of `g` along `f`. -/
def pb (U : Stage) (g : GIdx) (f : C(U.X, g.Base)) : Stage :=
  ⟨.pair U.shape (.prim g.amb), pbSet U.set g f, .pb g f U.isStage⟩

/-- The designated pullback stage is the topological pullback. -/
def pbHomeo (U : Stage) (g : GIdx) (f : C(U.X, g.Base)) : (pb U g f).X ≃ₜ TopPullback f g.map :=
  pbSetHomeo U.set g f

/-- The projection of a designated pullback to its base stage. -/
def pbProj (U : Stage) (g : GIdx) (f : C(U.X, g.Base)) : pb U g f ⟶ U :=
  (pbFst f g.map).comp (pbHomeo U g f : C((pb U g f).X, TopPullback f g.map))

theorem pbProj_apply (U : Stage) (g : GIdx) (f : C(U.X, g.Base)) (x : (pb U g f).X) :
    pbProj U g f x = pbFst f g.map (pbHomeo U g f x) := rfl

end Stage

end RealContinuity
